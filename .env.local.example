# Copy to .env.local and fill in. Used by src/app/api/contact/route.ts.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions are delivered
CONTACT_TO_EMAIL=

# Sender identity; onboarding@resend.dev works without verifying a domain
CONTACT_FROM_EMAIL=onboarding@resend.dev
